{
  "expo": {
    "name": "VillKro",
    "slug": "villkro",
    "version": "1.8.4",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "icon": "./assets/icon/icon.png",
    "splash": {
      "image": "./assets/icon/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#FFFFFF"
    },
    "plugins": [
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon/adaptive-icon-foreground.png",
          "color": "#FF6B35"
        }
      ],
      "expo-audio",
      "expo-asset",
      "./plugins/withAlarmSounds",
      "./plugins/withAlarmPermissions",
      "./plugins/withNotifeeMaven",
      [
        "@rnmapbox/maps",
        {}
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "VillKro uses your location to set your delivery address, show nearby stores, and track your order on the delivery map.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          },
          "ios": {
            "useFrameworks": "static",
            "buildReactNativeFromSource": true
          }
        }
      ]
    ],
    "ios": {
      "supportsTablet": false,
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "VillKro uses your location to set your delivery address, show nearby stores, and track your order on the delivery map.",
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.yashsiwach.villkro",
      "buildNumber": "6"
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "POST_NOTIFICATIONS",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "USE_FULL_SCREEN_INTENT",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_SPECIAL_USE",
        "FOREGROUND_SERVICE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.yashsiwach.villkro",
      "versionCode": 34,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon/adaptive-icon-foreground.png",
        "backgroundImage": "./assets/icon/adaptive-icon-background.png",
        "monochromeImage": "./assets/icon/adaptive-icon-foreground.png"
      }
    },
    "extra": {
      "eas": {
        "projectId": "1df5a9bf-de34-48ea-96f4-68f598d7d318"
      }
    },
    "owner": "yashsiwch",
    "runtimeVersion": "1.8.4",
    "updates": {
      "url": "https://u.expo.dev/1df5a9bf-de34-48ea-96f4-68f598d7d318"
    }
  }
}
